#!/bin/sh /etc/rc.common
# RILLANE daemon procd init 脚本（P3-3，platforms/openwrt）
# 安装：build.sh 产出的 ipk 自带本文件；手动安装时
#   install -m755 init.d/rillane /etc/init.d/rillane && /etc/init.d/rillane enable
#
# 说明：
# - rillaned 无 --config 参数面，配置路径经 RILLANE_CONFIG 环境变量注入
#   （与 Docker 镜像同款口径，见根 Dockerfile）；
# - TUN 虚拟化需 kmod-tun（ipk Depends 已声明）；仅 socks 入口 + DNS
#   监听面可不装 kmod-tun 运行（network 块缺席即可）。

USE_PROCD=1

START=99
STOP=10

PROG=/usr/bin/rillaned
CONF=/etc/rillane.yaml

start_service() {
	local enabled
	config_load rillane 2>/dev/null || true
	enabled="$(config_get enabled general enabled 1)"
	[ "$enabled" = "1" ] || return 0

	[ -x "$PROG" ] || {
		logger -t rillane "rillaned 未安装于 $PROG"
		return 1
	}
	[ -f "$CONF" ] || {
		logger -t rillane "缺少配置 $CONF（模板见 /usr/share/rillane/rillane.yaml.example）"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env RILLANE_CONFIG="$CONF"
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-0}"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0 0"
	procd_close_instance
}

reload_service() {
	stop
	start
}

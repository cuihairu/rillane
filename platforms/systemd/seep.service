[Unit]
Description=SEEP smart egress proxy daemon
Documentation=https://github.com/cuihairu/seep
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seep
Group=seep
# seepd 无 --config 旗标（platform-packaging.md §1.1）：配置路径环境变量注入
Environment=SEEP_CONFIG=/etc/seep/seep.yaml
ExecStart=/usr/bin/seepd
Restart=on-failure
RestartSec=5
# 最低权限面：低端口绑定（入口 0-1023）+ TUN 设备创建（P1-2 已落地）。
# 纯代理部署（无 TUN）可用 drop-in 收窄：systemctl edit seep 后覆写两行去掉
# CAP_NET_ADMIN。缺省按全功能口径给齐。
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# PrivateDevices 不可开：TUN 面（P1-2）需访问 /dev/net/tun
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
RestrictRealtime=yes
# 有意不设 MemoryDenyWriteExecute=yes：wasmtime JIT（P3-2 插件面）需要 W→X
# 映射的代码页，该旗标会使插件载入/实例化失败（platform-packaging.md §6 边界 3）。
# 有意不设 SystemCallFilter：过紧易误伤 aws-lc-sys/io_uring 面，收紧归后续。

[Install]
WantedBy=multi-user.target

# RILLANE minimal runnable config (macOS launchd template - /usr/local/etc/rillane/rillane.yaml)
#
# Same schema as config/rillane.yaml; minimal face = socks ingress + direct egress.
# install.sh copies this file when the target config is absent. Edit admin_token
# before `launchctl kickstart system/com.rillane.rillaned`.
#
# NOTE: the TUN face (network.tun) is Linux-only (P1-2); macOS tunnel integration
# goes through NEPacketTunnelProvider (P3-4 rillane-ffi direction). Deliberately
# absent here.

control:
  api_bind: 127.0.0.1:9090
  uds_path: null
  admin_token: change-me

telemetry:
  log_level: info
  enable_metrics: true
  enable_tracing: false

ingress:
  - name: socks-in
    type: socks5
    bind: 0.0.0.0:7890

egress:
  - name: direct-main
    type: direct

routing:
  default_node: direct-main
  groups: []
  rules: []
